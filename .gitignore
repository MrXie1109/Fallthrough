target/
# Machine-local Cargo configuration and environment (.cargo/env,
# .cargo/config.toml). A clone builds with the standard Cargo setup.
.cargo/
**/*.rs.bk
Cargo.lock.bak
.cargo-home/

# Scratch space for compiling throwaway programs by hand. Outputs are
# binaries and generated IR, never sources worth keeping.
scratch/
.scratch/

# Commit message drafts.
.git-msg/

# Cooperative file locks for parallel agents.
.locks/

# Scratch programs written while checking the compiler by hand.
.tmp/

# Intermediate objects a compile leaves beside its input.
*.fallc-tmp.o

# Machine-local agent constitution: per-host working rules (memory floor,
# conflict policy). Personal to this checkout, not part of the project.
CONSTITUTION.md

# Local working tools: memory guard, doc generators, one-off scripts. Machine
# conveniences for building this checkout, not part of what the project ships.
tools/
