// The floating-point mathematics library.
//
// Part of the C bindings: the declarations from `math.h`.
//
// This module is not meant to be imported on its own. `standard/C.ftm` gathers
// it with the others and re-exports everything, so `import C;` is what a
// program writes and `C.printf` is what it calls.
//
// Every declaration is `export`, which is what makes it visible to the module
// that re-exports it; a module's declarations are private by default.

// ----------------------------------------------------------------- math.h

// The absolute value of a double.
@cabi export fn fabs(value double) double;

// The square root.
@cabi export fn sqrt(value double) double;

// Raises to a power.
@cabi export fn pow(base double, exponent double) double;

// The exponential function.
@cabi export fn exp(value double) double;

// The natural logarithm.
@cabi export fn log(value double) double;

// The base-10 logarithm.
@cabi export fn log10(value double) double;

// The sine.
@cabi export fn sin(value double) double;

// The cosine.
@cabi export fn cos(value double) double;

// The tangent.
@cabi export fn tan(value double) double;

// The floor.
@cabi export fn floor(value double) double;

// The ceiling.
@cabi export fn ceil(value double) double;

// Rounds to the nearest integer.
@cabi export fn round(value double) double;

// The floating-point remainder.
@cabi export fn fmod(numerator double, denominator double) double;

// The angle whose sine is `value`, in radians.
@cabi export fn asin(value double) double;

// The angle whose cosine is `value`, in radians.
@cabi export fn acos(value double) double;

// The angle whose tangent is `value`, in radians.
@cabi export fn atan(value double) double;

// The angle of the point `(x, y)`, in radians.
@cabi export fn atan2(y double, x double) double;

// The base-2 logarithm.
@cabi export fn log2(value double) double;

// The hypotenuse, computed without intermediate overflow.
@cabi export fn hypot(x double, y double) double;

// The cube root.
@cabi export fn cbrt(value double) double;

// The integer part, toward zero.
@cabi export fn trunc(value double) double;

// The hyperbolic sine.
@cabi export fn sinh(value double) double;

// The hyperbolic cosine.
@cabi export fn cosh(value double) double;

// The hyperbolic tangent.
@cabi export fn tanh(value double) double;

// The inverse hyperbolic sine.
@cabi export fn asinh(value double) double;

// The inverse hyperbolic cosine.
@cabi export fn acosh(value double) double;

// The inverse hyperbolic tangent.
@cabi export fn atanh(value double) double;

// Whether `value` is NaN.
@cabi export fn isnan(value double) i32;

// Whether `value` is infinite.
@cabi export fn isinf(value double) i32;
