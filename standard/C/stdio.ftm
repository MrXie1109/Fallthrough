// Reading and writing through the C standard I/O library.
//
// Part of the C bindings: the declarations from `stdio.h`.
//
// This module is not meant to be imported on its own. `standard/C.ftm` gathers
// it with the others and re-exports everything, so `import C;` is what a
// program writes and `C.printf` is what it calls.
//
// Every declaration is `export`, which is what makes it visible to the module
// that re-exports it; a module's declarations are private by default.

// The standard streams, which the C library owns.
//
// `stdin` is a `FILE *`, which this language has no type for; a stream is
// passed around opaquely, so the bindings name it `*c8` and the pointer is
// never dereferenced. The declaration is `extern` because the object is in the
// C library: `stdin` is not a variable of this program, it is one this program
// reaches.
export stdin *c8 @cabi;
export stdout *c8 @cabi;
export stderr *c8 @cabi;
// The value `getchar` and friends return at end of input.
//
// It is `int` rather than `char` because it has to be distinguishable from
// every byte, which a `char` return type could not express.
export EOF const int = -1;

// ---------------------------------------------------------------- stdio.h

// Writes formatted output to stdout.
@cabi export fn printf(fmt *const c8, ...) int;

// Writes formatted output to a stream.
@cabi export fn fprintf(stream *c8, fmt *const c8, ...) int;

// Writes formatted output into a buffer.
@cabi export fn sprintf(buffer *c8, fmt *const c8, ...) int;

// As `sprintf`, with a size limit.
@cabi export fn snprintf(buffer *c8, size usize, fmt *const c8, ...) int;

// Writes a string and a newline to stdout.
@cabi export fn puts(text *const c8) int;

// Writes a string to a stream.
@cabi export fn fputs(text *const c8, stream *c8) int;

// Writes one character to a stream.
@cabi export fn fputc(character int, stream *c8) int;

// Writes one character to stdout.
@cabi export fn putchar(character int) int;

// Reads formatted input from stdin.
@cabi export fn scanf(fmt *const c8, ...) int;

// Reads a line from a stream into a buffer.
@cabi export fn fgets(buffer *c8, size int, stream *c8) *c8;

// Reads one character from a stream.
@cabi export fn fgetc(stream *c8) int;

// Reads one character from stdin.
@cabi export fn getchar() int;

// Opens a file.
@cabi export fn fopen(path *const c8, mode *const c8) *c8;

// Closes a file. Returns zero on success.
@cabi export fn fclose(stream *c8) int;

// Flushes a stream's buffer.
@cabi export fn fflush(stream *c8) int;

// Reads a whole file into a buffer.
@cabi export fn fread(buffer *c8, size usize, count usize, stream *c8) usize;

// Writes to a file.
@cabi export fn fwrite(buffer *const c8, size usize, count usize, stream *c8) usize;

// Moves a stream's position.
@cabi export fn fseek(stream *c8, offset isize, whence int) int;

// Reports a stream's position.
@cabi export fn ftell(stream *c8) isize;

// Rewinds a stream to its start.
@cabi export fn rewind(stream *c8) void;

// Reports the end-of-file indicator.
@cabi export fn feof(stream *c8) int;

// Reports a stream error.
@cabi export fn ferror(stream *c8) int;

// Reports the last error as a string.
@cabi export fn strerror(code int) *c8;

// Removes a file or an empty directory. Returns zero on success.
@cabi export fn remove(path *const c8) int;

// Renames a file or a directory. Returns zero on success.
@cabi export fn rename(source *const c8, destination *const c8) int;
