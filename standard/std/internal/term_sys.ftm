// Whether a file descriptor is a terminal, as POSIX answers it.
//
// `isatty` is the question a colour library actually asks: a pipe and a file
// want plain text, and a terminal can take escape sequences. Linux and macOS
// share the call.

@extern_C fn isatty(fd i32) i32;

// Whether `fd` is a terminal.
export fn is_terminal(fd i32) bool {
    return isatty(fd) == 1;
}
