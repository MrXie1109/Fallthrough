// The system's entropy source, on a POSIX system.
//
// `/dev/urandom` is the file every Unix gives a program for exactly this: bytes
// the kernel has gathered from the hardware and the timing of events. It is
// read once, at setup, to seed the generator; nothing else in this module runs
// afterwards.
//
// A platform that has no such file provides its own `random_entropy.<os>.ftm`;
// the loader prefers it to this one, and the two agree on `fill`.

import std.io;
from std.io import File, OpenMode;

// Fills `buffer` with `count` bytes from the system's entropy source.
//
// Returns `false` when the source could not give the bytes -- a platform with no
// `/dev/urandom` and no closer answer -- and the caller then seeds from the
// clock instead of leaving the generator at its default seed.
export fn fill(buffer *byte, count usize) bool except {
    source File = File("/dev/urandom", OpenMode.READ)??;
    got usize = source.read(buffer, count)??;
    source.close()??;
    return got == count;
}
