// Control flow, as a program that runs.
//
// This file used to be a sketch: it named variables that were never declared,
// so it compiled into nothing anyone could run. An example that cannot be run
// is an example that silently stops being true, so it is a real program now.
//
// `describe` is the interesting one. A `case` does not fall into the next by
// itself; `fallthrough;` says so explicitly, which is what `case 2` below does.

import C;

// Which branch of an `if`/`else if`/`else` a value takes.
fn classify(n int) int {
    if (n < 0) {
        return 1;
    } else if (n == 0) {
        return 2;
    } else {
        return 3;
    }
}

// A switch with an explicit fall-through, a shared label, and a default.
fn describe(e int) int {
    switch (e) {
        case 1:
            return 10;
        case 2:
            // Falls into `case 3`, so 2 and 3 both give 30.
            fallthrough;
        case 3:
            return 30;
        case 4, 5:
            // Two labels for one body.
            return 45;
        default:
            return 99;
    }
}

// A loop that runs to completion, so its `else` clause runs.
fn count_down(start int) int {
    steps int = 0;
    i int = start;
    while (i > 0) {
        steps = steps + 1;
        i = i - 1;
    } else {
        // The loop `else` runs when the loop finished without `break`.
        steps = steps + 100;
    }
    return steps;
}

// A loop left early by `break`, so its `else` clause does not run.
fn first_divisor(n int) int {
    d int = 2;
    while (d < n) {
        if (n % d == 0) {
            break;
        }
        d = d + 1;
    } else {
        d = -1;
    }
    return d;
}

// The C-style `for`: initialise, test, step.
fn sum_to(limit int) int {
    total int = 0;
    for (i int = 1; i <= limit; i++) {
        total = total + i;
    }
    return total;
}

fn main() int {
    C.printf("classify: -5=%d 0=%d 5=%d\n", classify(-5), classify(0), classify(5));
    C.printf("switch:   1=%d 2=%d 3=%d 4=%d 9=%d\n",
        describe(1), describe(2), describe(3), describe(4), describe(9));
    C.printf("while else ran:      %d\n", count_down(3));
    C.printf("first_divisor(15):   %d\n", first_divisor(15));
    C.printf("first_divisor(7):    %d\n", first_divisor(7));
    C.printf("sum_to(10):          %d\n", sum_to(10));
    return 0;
}
